# ===== Server — Jaya Abadi API =====
# Salin jadi .env lalu ubah nilainya. JANGAN commit .env.

# Koneksi PostgreSQL (wajib)
DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/jayaabadi"

# Koneksi pooled (opsional — Prisma Postgres cloud untuk runtime serverless)
DATABASE_URL_POOLED=""

# Secret token JWT — WAJIB ganti dengan string acak baru di setiap environment
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Origin frontend yang diizinkan CORS (wajib)
CLIENT_URL="http://localhost:5173"

# Port HTTP server (opsional, default 4000)
PORT=4000

# URL publik server — dipakai membangun URL absolut media/uploads (opsional)
SERVER_URL="http://localhost:4000"

# URL publik website — dipakai sitemap.xml dan robots.txt (opsional)
SITE_URL="http://localhost:5173"

# Password admin awal untuk seed (wajib sebelum npm run seed)
SEED_ADMIN_PASSWORD="ganti-password-seed"

# Environment (opsional — "production" mengaktifkan secure cookie)
NODE_ENV=

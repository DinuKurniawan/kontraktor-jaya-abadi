// Schema database Jaya Abadi — PostgreSQL
// Tabel dipetakan ke snake_case lewat @@map

generator client {
  provider      = "prisma-client-js"
  // Binary target Linux agar client berjalan di Vercel (rhel-openssl-3.0.x)
  // tanpa menghapus target native Windows untuk pengembangan lokal.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role user untuk CMS admin
enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR

  @@map("role")
}

// Tipe kategori: dipakai oleh proyek atau artikel
enum CategoryType {
  PROJECT
  POST

  @@map("category_type")
}

// Status progres proyek
enum ProjectStatus {
  PLANNING
  ONGOING
  COMPLETED

  @@map("project_status")
}

enum BudgetRange {
  KURANG_100JT
  RANGE_100_500JT @map("100_500JT")
  RANGE_500JT_1M  @map("500JT_1M")
  RANGE_1M_5M     @map("1M_5M")
  LEBIH_5M
  BELUM_TAHU

  @@map("budget_range")
}

enum PreferredContact {
  WHATSAPP
  TELEPON
  EMAIL

  @@map("preferred_contact")
}

enum PreferredTime {
  PAGI
  SIANG
  SORE
  BEBAS

  @@map("preferred_time")
}

enum MessageStatus {
  BARU
  DIPROSES
  SELESAI
  SPAM

  @@map("message_status")
}

// User CMS (superadmin, admin, editor)
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(EDITOR)
  isActive  Boolean  @default(true)
  position  String?
  photo     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[] @relation("PostAuthor")

  @@map("users")
}

// Kategori proyek / artikel
model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  type      CategoryType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  projects Project[]
  posts    Post[]

  @@index([type])
  @@map("categories")
}

// Proyek konstruksi
model Project {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  summary     String
  description String        @db.Text
  location    String
  clientName  String
  year        Int
  value       String? // nilai kontrak, opsional (mis. "Rp 1,2 M")
  status      ProjectStatus @default(PLANNING)
  coverImage  String
  isFeatured  Boolean       @default(false)
  isPublished Boolean       @default(false)
  categoryId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Spesifikasi
  area            Int? // m²
  durationMonths  Int?
  floors          Int?
  startDate       DateTime?
  endDate         DateTime?
  architect       String?
  videoUrl        String?
  // Cerita proyek
  challenge       String?   @db.Text
  solution        String?   @db.Text
  result          String?   @db.Text
  highlights      Json? // array string
  tags            Json? // array string
  // Lokasi & statistik
  latitude        Float?
  longitude       Float?
  viewCount       Int       @default(0)
  // SEO
  metaTitle       String?
  metaDescription String?

  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  service      Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId    String?
  images       ProjectImage[]
  beforeAfters BeforeAfter[]

  @@index([status])
  @@index([categoryId])
  @@index([isPublished, isFeatured])
  @@map("projects")
}

// Galeri foto proyek
model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_images")
}

// Layanan jasa (konstruksi, renovasi, interior, pengawasan)
model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services Service[]

  @@index([sortOrder])
  @@map("service_categories")
}

model Service {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  shortDesc       String
  description     String   @db.Text
  icon            String
  image           String?
  // Konten halaman detail layanan
  heroImage       String?
  longDescription String?  @db.Text
  startingPrice   Int? // Rupiah, opsional
  brochureUrl     String?
  metaTitle       String?
  metaDescription String?
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)
  isPublished     Boolean  @default(false)
  categoryId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  scopes       ServiceScope[]
  packages     ServicePackage[]
  projects     Project[]
  faqs         Faq[]
  processSteps ProcessStep[]
  testimonials Testimonial[]
  messages     Message[]

  @@index([sortOrder])
  @@index([categoryId])
  @@map("services")
}

// Ruang lingkup pekerjaan per layanan
model ServiceScope {
  id          String  @id @default(cuid())
  serviceId   String
  title       String
  description String  @db.Text
  icon        String?
  sortOrder   Int     @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
  @@map("service_scopes")
}

// Paket harga per layanan
model ServicePackage {
  id          String  @id @default(cuid())
  serviceId   String
  name        String
  description String  @db.Text
  priceFrom   Int // Rupiah
  priceUnit   String  @default("per m²")
  features    Json // array of string
  isPopular   Boolean @default(false)
  ctaLabel    String  @default("Konsultasi Sekarang")
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
  @@map("service_packages")
}

// Artikel / berita
model Post {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String
  content         String    @db.Text
  coverImage      String
  authorId        String
  categoryId      String?
  readTime        Int       @default(5) // estimasi waktu baca (menit)
  isPublished     Boolean   @default(false)
  isFeatured      Boolean   @default(false)
  viewCount       Int       @default(0)
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author   User      @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     PostTag[]

  @@index([authorId])
  @@index([categoryId])
  @@index([isPublished, publishedAt])
  @@index([isPublished, isFeatured])
  @@index([viewCount])
  @@map("posts")
}

// Tag artikel — satu artikel dapat memiliki banyak tag dan sebaliknya
model Tag {
  id    String    @id @default(cuid())
  name  String
  slug  String    @unique
  posts PostTag[]

  @@map("tags")
}

// Relasi many-to-many artikel dan tag
model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// Testimoni klien
model Testimonial {
  id          String   @id @default(cuid())
  name        String
  position    String
  company     String?
  content     String
  rating      Int      @default(5) // 1-5, divalidasi lewat Zod
  avatar      String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId String?

  @@index([isPublished])
  @@map("testimonials")
}

// Profil tim / manajemen
model TeamMember {
  id          String         @id @default(cuid())
  name        String
  position    String
  photo       String?
  bio         String?
  department  TeamDepartment @default(MANAJEMEN)
  email       String?
  linkedin    String?
  instagram   String?
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([sortOrder])
  @@map("team_members")
}

// ===== Konten halaman Tentang Kami =====

// Departemen tim (filter halaman tim)
enum TeamDepartment {
  MANAJEMEN
  TEKNIK
  ARSITEK_INTERIOR
  PENGAWAS
  ADMINISTRASI
}

// Milestone perjalanan perusahaan (timeline sejarah)
model Milestone {
  id          String  @id @default(cuid())
  year        Int
  title       String
  description String  @db.Text
  image       String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  @@index([sortOrder])
  @@map("milestones")
}

// Nilai-nilai perusahaan
model CoreValue {
  id          String  @id @default(cuid())
  title       String
  description String  @db.Text
  icon        String
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  @@index([sortOrder])
  @@map("core_values")
}

// Galeri foto perusahaan
enum GalleryCategory {
  KEGIATAN
  PROYEK
  KANTOR
  PENGHARGAAN
}

model GalleryItem {
  id          String          @id @default(cuid())
  image       String
  caption     String?
  category    GalleryCategory
  sortOrder   Int             @default(0)
  isPublished Boolean         @default(true)
  createdAt   DateTime        @default(now())

  @@index([sortOrder])
  @@map("gallery_items")
}

// Slide hero di halaman depan
model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  ctaLabel  String?
  ctaUrl    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("hero_slides")
}

// Pesan dari form kontak
model Message {
  id               String           @id @default(cuid())
  name             String
  email            String
  phone            String
  subject          String
  body             String           @db.Text
  serviceId        String?
  budgetRange      BudgetRange?
  projectLocation  String?
  projectArea      Int?
  startEstimate    String?
  preferredContact PreferredContact @default(WHATSAPP)
  preferredTime    PreferredTime    @default(BEBAS)
  attachments      Json             @default("[]")
  status           MessageStatus    @default(BARU)
  adminNote        String?          @db.Text
  ticketCode       String           @unique
  source           String?
  isRead           Boolean          @default(false)
  createdAt        DateTime         @default(now())

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([isRead])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([serviceId])
  @@map("messages")
}

// Cabang kantor yang ditampilkan di halaman kontak publik
model Branch {
  id           String   @id @default(cuid())
  name         String
  address      String
  city         String
  phone        String
  whatsapp     String
  email        String
  latitude     Float
  longitude    Float
  mapEmbedUrl  String
  openingHours Json
  photo        String?
  isMain       Boolean  @default(false)
  sortOrder    Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, isMain, sortOrder])
  @@map("branches")
}

// Pengaturan situs (key-value): profil perusahaan, kontak, visi misi, statistik
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Mitra / klien yang pernah bekerja sama
model Partner {
  id          String  @id @default(cuid())
  name        String
  logo        String?
  website     String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  @@map("partners")
}

// Sertifikat & legalitas perusahaan
model Certificate {
  id          String  @id @default(cuid())
  title       String
  issuer      String?
  image       String?
  year        Int?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  @@map("certificates")
}

// Tanya jawab umum
model Faq {
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  id          String   @id @default(cuid())
  question    String
  answer      String   @db.Text
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)

  @@map("faqs")
}

// Pelanggan newsletter (email unik)
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("subscribers")
}

// Keunggulan perusahaan (why us)
model Feature {
  id          String  @id @default(cuid())
  title       String
  description String  @db.Text
  icon        String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  @@map("features")
}

// Langkah alur kerja
model ProcessStep {
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)

  @@map("process_steps")
}

// Perbandingan sebelum/sesudah per proyek
model BeforeAfter {
  id          String   @id @default(cuid())
  title       String
  location    String?
  beforeImage String
  afterImage  String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)

  @@map("before_after")
}

// Harga estimasi per tipe bangunan (kalkulator)
enum BuildingType {
  RUMAH
  RUKO
  RENOVASI
  INTERIOR
}

model EstimatePrice {
  id            String       @id @default(cuid())
  buildingType  BuildingType
  label         String
  pricePerM2Min Int
  pricePerM2Max Int
  isPublished   Boolean      @default(true)

  @@map("estimate_prices")
}

// Media hasil upload (dikelola multer)
model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String
  size      Int // ukuran dalam byte
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("media")
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://server-two-zeta-88.vercel.app/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
